{
  "name": "iptv-manager",
  "version": "1.0.0",
  "description": "Gestionnaire IPTV - Lecture et organisation de playlists M3U",
  "main": "main.js",
  "scripts": {
    "start": "npm run build-renderer && launch.bat",
    "dev": "concurrently -k \"webpack --mode development --watch\" \"launch.bat\"",
    "electron": "launch.bat",
    "build-renderer": "webpack --mode production",
    "build": "npm run build-renderer && electron-builder --win",
    "build-mobile": "webpack --config webpack.mobile.config.js",
    "sync-android": "npm run build-mobile && cap sync android",
    "apk": "npm run sync-android && cd android && gradlew.bat assembleDebug",
    "open-android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/app-launcher": "^6.0.4",
    "@capacitor/core": "^6.2.1",
    "hls.js": "^1.7.1",
    "mpegts.js": "^1.8.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "@capacitor/cli": "^6.2.1",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.9.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.iptv.manager",
    "productName": "IPTV Manager",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "db/**/*",
      "utils/**/*",
      "node_modules/**/*"
    ],
    "extraResources": []
  }
}
